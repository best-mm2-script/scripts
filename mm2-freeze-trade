function RoleManager.Refresh()
    MM2Client.Murderer.Detected = false
    MM2Client.Sheriff.Detected = false
    MM2Client.Roles.Scanned = false
end

function RoleManager.GetMurderer()
    return MM2Client.Murderer.Player
end

function RoleManager.GetSheriff()
    return MM2Client.Sheriff.Player
end

function RoleManager.GetHero()
    return MM2Client.Roles.Hero
end

function RoleManager.Clear()
    MM2Client.Murderer.Player = nil
    MM2Client.Sheriff.Player = nil
    MM2Client.Roles.Hero = nil
end

function RoleManager.Reset()
    MM2Client.Roles.Current = "Unknown"
    MM2Client.Roles.Previous = "Unknown"
end

local FreezeManager = {}

